{
  "name": "rice-flight-log",
  "version": "1.0.0",
  "private": true,
  "description": "Rice family flight logbook — Cloudflare Worker + D1 dashboard",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create rice-flight-log",
    "db:migrate:local": "wrangler d1 execute rice-flight-log --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute rice-flight-log --remote --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute rice-flight-log --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute rice-flight-log --remote --file=./seed.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0",
    "typescript": "^5.6.0",
    "@cloudflare/workers-types": "^4.20240925.0"
  }
}
